---
import CommunityCard from './CommunityCard.astro';
import NetworkMap from './NetworkMap.astro';
import { communities } from '../data/communities';
---

<section class="section communities" id="communities">
  <div class="page-shell">
    <p class="section-eyebrow">Communities</p>
    <h2 class="section-heading">AI Safety across Sweden</h2>
    <p class="section-lede">Find people working on AI safety near you.</p>

    <div class="communities__body">
      <figure class="communities__map">
        <p class="communities__map-label">The network</p>
        <NetworkMap />
        <figcaption class="communities__map-caption">
          One national network. Local communities.
        </figcaption>
      </figure>

      <div class="communities__content">
        <ul class="communities__grid">
          {
            communities.map((community) => (
              <li>
                <CommunityCard community={community} />
              </li>
            ))
          }
          <li>
            <article class="community-card community-card--invite">
              <p class="community-card__region">Elsewhere in Sweden</p>
              <h3 class="community-card__name">Your city</h3>
              <p class="community-card__blurb">
                No local community where you are? Starting one is a route into the network.
              </p>
              <a class="link-arrow community-card__cta" href="#get-involved">
                Start a community <span class="link-arrow__glyph" aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        </ul>
        <p class="communities__note">
          Local contacts, links and community pages are published here as they are confirmed
          with local organisers.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .communities__body {
    margin-top: var(--space-2xl);
    display: grid;
    /* Roughly 42/58 — the map is a co-equal element, not an illustration. */
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    gap: clamp(var(--space-xl), 4vw, var(--space-2xl));
    align-items: stretch;
  }

  /* Stretching the column lets the closing note settle against the foot of the
     map panel instead of leaving a void beside it. */
  .communities__content {
    display: flex;
    flex-direction: column;
  }

  .communities__map {
    margin: 0;
    padding: var(--space-lg) var(--space-md);
    background: var(--colour-paper-raised);
    border: 1px solid var(--colour-rule);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-md);
  }

  .communities__map-label,
  .communities__map-caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--colour-ink-muted);
    text-align: center;
  }

  .communities__map-caption {
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--colour-ink-soft);
  }

  .communities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The invitation closes the grid, so it runs full width under the cities. */
  .communities__grid > li:last-child {
    grid-column: 1 / -1;
  }

  .communities__note {
    margin-top: auto;
    padding-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--colour-ink-muted);
    max-width: 52ch;
  }

  /* Mirrors .community-card in CommunityCard.astro; scoped styles do not leak
     between components, so the invitation card restates them. */
  .community-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    height: 100%;
  }

  .community-card--invite {
    background: var(--colour-blue-wash);
    border: 1px dashed var(--colour-rule-strong);
  }

  .community-card__region {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--colour-ink-muted);
  }

  .community-card__name {
    font-size: var(--text-xl);
    text-wrap: balance;
  }

  .community-card__blurb {
    font-size: var(--text-sm);
    color: var(--colour-ink-soft);
  }

  .community-card__cta {
    margin-top: auto;
    padding-top: var(--space-md);
  }

  @media (max-width: 60rem) {
    .communities__body {
      grid-template-columns: 1fr;
    }
  }
</style>
