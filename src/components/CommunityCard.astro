---
import type { Community } from '../types/content';

interface Props {
  community: Community;
}

const { community } = Astro.props;

// A card only becomes a link once its data carries a confirmed URL. Until then
// it stays a plain article, so nothing implies a destination, an organiser or
// an activity level that has not been agreed.
const hasPage = Boolean(community.url);
const Tag = hasPage ? 'a' : 'article';
const isExternal = community.url?.startsWith('http') ?? false;
---

<Tag
  class:list={['community-card', { 'community-card--linked': hasPage }]}
  id={community.id}
  {...hasPage ? { href: community.url } : {}}
  {...isExternal ? { rel: 'noopener' } : {}}
>
  <p class="community-card__region">{community.region}</p>
  <h3 class="community-card__name">{community.name ?? community.city}</h3>
  {community.name && <p class="community-card__city">{community.city}</p>}
  {community.blurb && <p class="community-card__blurb">{community.blurb}</p>}
  {
    hasPage ? (
      <span class="link-arrow community-card__cta">
        Explore community <span class="link-arrow__glyph" aria-hidden="true">→</span>
      </span>
    ) : (
      <p class="community-card__pending">Details coming soon</p>
    )
  }
</Tag>

<style>
  .community-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    background: var(--colour-paper-raised);
    border: 1px solid var(--colour-rule);
    border-radius: var(--radius-md);
    min-height: 8rem;
    height: 100%;
    text-decoration: none;
    scroll-margin-top: 5rem;
  }

  .community-card--linked {
    transition: border-color 140ms ease, transform 140ms ease;
  }

  .community-card--linked:hover {
    border-color: var(--colour-blue);
    transform: translateY(-2px);
  }

  .community-card__region {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--colour-ink-muted);
  }

  .community-card__name {
    font-size: var(--text-xl);
    text-wrap: balance;
  }

  .community-card__city {
    font-size: var(--text-sm);
    color: var(--colour-ink-soft);
  }

  .community-card__blurb {
    font-size: var(--text-sm);
    color: var(--colour-ink-soft);
  }

  .community-card__cta {
    margin-top: auto;
    padding-top: var(--space-md);
  }

  /* Held deliberately quiet, and kept next to the heading rather than pushed
     to the foot of the card, so an empty card stays compact. */
  .community-card__pending {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--colour-ink-muted);
    opacity: 0.75;
  }
</style>
