---
import HeroMotif from './HeroMotif.astro';

/**
 * Above-the-fold statement. Keep it to one headline, one supporting sentence
 * and two calls to action — a visitor should understand what this is in a few
 * seconds without reading an explanation of AI safety.
 *
 * On desktop the copy takes a wide left column and the network lattice fills
 * the right, so the composition is deliberate rather than merely left-aligned.
 */
---

<section class="hero">
  <div class="page-shell hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">Sweden · AI safety community network</p>
      <h1 class="hero__headline">Building Sweden's AI safety community.</h1>
      <p class="hero__lede">
        A network of people and local communities working to understand and reduce risks from
        advanced AI.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#communities">Find your community</a>
        <a class="button button--secondary" href="#events">Upcoming events</a>
      </div>
    </div>

    <HeroMotif />
  </div>
  <div class="hero__rule" aria-hidden="true"></div>
</section>

<style>
  .hero__inner {
    padding-block: clamp(3rem, 2rem + 7vw, 7rem) clamp(2.5rem, 1.5rem + 5vw, 5rem);
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--colour-ink-muted);
  }

  .hero__headline {
    margin-top: var(--space-lg);
    font-size: var(--text-4xl);
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .hero__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--colour-ink-soft);
    max-width: 44ch;
  }

  .hero__actions {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* A single hairline of the flag palette, used as punctuation rather than decoration. */
  .hero__rule {
    height: 2px;
    background: linear-gradient(
      to right,
      var(--colour-blue) 0 22%,
      var(--colour-yellow) 22% 30%,
      var(--colour-rule) 30% 100%
    );
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 66fr) minmax(0, 34fr);
    }
  }
</style>
