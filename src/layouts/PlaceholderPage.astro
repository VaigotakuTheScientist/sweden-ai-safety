---
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

/**
 * Minimal holding page for a navigation destination that has not been written
 * yet. Deliberately says so plainly rather than filling the page with copy we
 * cannot stand behind. Replace with a real page — do not grow this layout into
 * a content system.
 */
interface Props {
  title: string;
  intro: string;
  eyebrow?: string;
  note?: string;
}

const {
  title,
  intro,
  eyebrow = 'In progress',
  note = "This page has not been written yet. It is listed here so the site's structure is visible while the content is prepared.",
} = Astro.props;
---

<BaseLayout title={`${title} — ${site.name}`} description={intro}>
  <section class="section section--flush placeholder">
    <div class="page-shell">
      <p class="section-eyebrow">{eyebrow}</p>
      <h1 class="placeholder__heading">{title}</h1>
      <p class="placeholder__intro">{intro}</p>
      {note && <p class="placeholder__note">{note}</p>}
      <a class="link-arrow placeholder__back" href="/">
        <span class="link-arrow__glyph" aria-hidden="true">←</span> Back to the homepage
      </a>
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem);
  }

  .placeholder__heading {
    font-size: var(--text-3xl);
    max-width: 20ch;
  }

  .placeholder__intro {
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
    color: var(--colour-ink-soft);
    max-width: var(--measure);
  }

  .placeholder__note {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--colour-ink-muted);
    max-width: var(--measure);
  }

  .placeholder__back {
    margin-top: var(--space-xl);
  }
</style>
